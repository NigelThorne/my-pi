# Lowercase ASCII names, unsigned integer text, mandatory LF after each row.
# Empty input is an empty object after transformation. Duplicate names last-win.
root document
document <- rows:row+ / empty:!.
row <- name:identifier "=" digits:unsigned_integer "\n"
identifier <- [a-z]+
unsigned_integer <- [0-9]+

@test(identifier) "lowercase identifier" { input: "apples" expect: "apples" }
@test(identifier) "identifier rejects punctuation" { input: "apples!" reject: true }
@test(unsigned_integer) "integer spelling preserved" { input: "0012" expect: "0012" }

# Test the helper without the document's rows wrapper.
@test(row) "single row helper" {
  input: "apples=12\n"
  expect: { name: "apples", digits: "12" }
}
@test(row) "helper rejects a second row" {
  input: "apples=12\npears=3\n"
  reject: true
}

@test "empty" { input: "" expect: { empty: "" } }
@test "one" {
  input: "apples=12\n"
  expect: { rows: [{ name: "apples", digits: "12" }] }
}
@test "many" {
  input: "apples=12\npears=3\n"
  expect: { rows: [{ name: "apples", digits: "12" }, { name: "pears", digits: "3" }] }
}
@test "missing value" { input: "apples=\n" reject: true }
@test "missing newline" { input: "apples=12" reject: true }
@test "negative" { input: "apples=-1\n" reject: true }
@test "trailing junk" { input: "apples=12\n!" reject: true }
